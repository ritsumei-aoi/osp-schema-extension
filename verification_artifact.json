{
  "title": "Triviality conditions for C(n+1) inhomogeneous deformation",
  "theorem": "For all n >= 1, the inhomogeneous deformation gamma_gb of C(n+1) = osp(2|2n) is trivial (i.e., gamma_gb = delta f for some odd linear map f) if and only if gb_{sigma,k,s} = 0 for all sigma in {+,-}, k in {1,...,n}, s in {+,-}.",
  "proof_mechanism": {
    "step1": "The diagonal pair (F_{sigma,k,s}, F_{sigma,k,s}) yields the constraint: sigma * phi_eps + s * phi_k = gb_{sigma,k,s}, where phi_eps, phi_k are the N_eps, N_k components of f(F_{sigma,k,s}).",
    "step2": "The cross pair (F_{sigma,k,s}, F_{-sigma,k,-s}) yields the constraint: sigma * phi_eps + s * phi_k = 0. This arises because the bracket [F_{sigma,k,s}, F_{-sigma,k,-s}] = sigma*s*(N_k - sigma*s*N_eps) is a Cartan element whose eigenvalue on F_{-sigma,k,-s} is zero.",
    "step3": "Combining steps 1 and 2: gb_{sigma,k,s} = 0."
  },
  "structure_constants_n1": {
    "basis": [
      "N_eps",
      "N_1",
      "E_+",
      "E_-",
      "f_1",
      "f_2",
      "f_3",
      "f_4"
    ],
    "parity": [
      0,
      0,
      0,
      0,
      1,
      1,
      1,
      1
    ],
    "nonzero_brackets": {
      "[N_1, E_+]": "2 E_+",
      "[N_1, E_-]": "-2 E_-",
      "[E_+, E_-]": "-N_1",
      "[N_eps, f_1]": "f_1",
      "[N_eps, f_2]": "f_2",
      "[N_eps, f_3]": "-f_3",
      "[N_eps, f_4]": "-f_4",
      "[N_1, f_1]": "f_1",
      "[N_1, f_2]": "-f_2",
      "[N_1, f_3]": "f_3",
      "[N_1, f_4]": "-f_4",
      "[E_+, f_2]": "-f_1",
      "[E_+, f_4]": "-f_3",
      "[E_-, f_1]": "f_2",
      "[E_-, f_3]": "f_4",
      "{f_1, f_3}": "2 E_+",
      "{f_2, f_4}": "2 E_-",
      "{f_1, f_4}": "N_1 - N_eps",
      "{f_2, f_3}": "N_1 + N_eps"
    }
  },
  "gamma_formulas": {
    "odd_odd": "gamma(F_{sigma,k,s}, F_{tau,l,t}) = gb_{tau,k,s} F_{sigma,l,t} + gb_{sigma,l,t} F_{tau,k,s}",
    "even_odd_N_eps": "gamma(N_eps, F_{sigma,k,t}) = -gb_{sigma,k,t} N_eps",
    "even_odd_N_k": "gamma(N_k, F_{sigma,j,t}) = -gb_{sigma,k,-} b_k^+ b_j^t - gb_{sigma,k,+} b_j^t b_k^-"
  },
