    },
    "n=3": {
      "even_dimension": 22,
      "odd_dimension": 12,
      "total_dimension": 34,
      "gb_parameter_count": 12
    }
  },
  "verification_targets": [
    "Check that the gauge-transformed oscillators reproduce the deformed cross-brackets.",
    "Check that T = id + kappa f is even and parity-preserving on the total space.",
    "Check that T^{-1}[T(X),T(Y)]_0 = [X,Y]_0 + kappa * (delta f)(X,Y) modulo kappa^2.",
    "Check that only scalar terms appear outside g, and that they vanish in the adjoint representation."
  ]
}
